      </RoutineSettingsComponent>
      <CodeComponent name="Scenesetup" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="env_clean = env.toString().toLowerCase().strip();&amp;#10;distance_clean = distance.toString().toLowerCase().strip();&amp;#10;if ((env_clean === &quot;city&quot;)) {&amp;#10;    env_label = &quot;CITY CENTRE&quot;;&amp;#10;    bg_color = &quot;#5f6672&quot;;&amp;#10;    pave_color = &quot;#9aa0a8&quot;;&amp;#10;    road_color = &quot;#55555c&quot;;&amp;#10;    number_of_cars = 4;&amp;#10;} else {&amp;#10;    if ((env_clean === &quot;suburb&quot;)) {&amp;#10;        env_label = &quot;QUIET SUBURB&quot;;&amp;#10;        bg_color = &quot;#a9d68f&quot;;&amp;#10;        pave_color = &quot;#cfe8b8&quot;;&amp;#10;        road_color = &quot;#6a6a6a&quot;;&amp;#10;        number_of_cars = 1;&amp;#10;    } else {&amp;#10;        throw new ValueError((&quot;Invalid environment: &quot; + env.toString()));&amp;#10;    }&amp;#10;}&amp;#10;car1_opacity = 1;&amp;#10;car2_opacity = ((number_of_cars &gt;= 2) ? 1 : 0);&amp;#10;car3_opacity = ((number_of_cars &gt;= 3) ? 1 : 0);&amp;#10;car4_opacity = ((number_of_cars &gt;= 4) ? 1 : 0);&amp;#10;if ((distance_clean === &quot;far&quot;)) {&amp;#10;    xs = [0.5, 0.58, 0.66];&amp;#10;} else {&amp;#10;    xs = [0.15, 0.3, 0.45];&amp;#10;}&amp;#10;positions = [];&amp;#10;for (var x, _pj_c = 0, _pj_a = xs, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    x = _pj_a[_pj_c];&amp;#10;    positions.push([(- x), (- 0.08)]);&amp;#10;    positions.push([x, (- 0.08)]);&amp;#10;}&amp;#10;[ped1_pos, ped2_pos, ped3_pos, ped4_pos, ped5_pos, ped6_pos] = positions;&amp;#10;n = Number.parseInt(n_others);&amp;#10;ped1_opacity = ((n &gt;= 1) ? 1 : 0);&amp;#10;ped2_opacity = ((n &gt;= 2) ? 1 : 0);&amp;#10;ped3_opacity = ((n &gt;= 3) ? 1 : 0);&amp;#10;ped4_opacity = ((n &gt;= 4) ? 1 : 0);&amp;#10;ped5_opacity = ((n &gt;= 5) ? 1 : 0);&amp;#10;ped6_opacity = ((n &gt;= 6) ? 1 : 0);&amp;#10;Background.setFillColor(bg_color);&amp;#10;Background.setLineColor(bg_color);&amp;#10;Farpavement.setFillColor(pave_color);&amp;#10;Farpavement.setLineColor(pave_color);&amp;#10;Road.setFillColor(road_color);&amp;#10;Road.setLineColor(road_color);&amp;#10;Nearpavement.setFillColor(pave_color);&amp;#10;Nearpavement.setLineColor(pave_color);&amp;#10;Car1.setOpacity(car1_opacity);&amp;#10;Car2.setOpacity(car2_opacity);&amp;#10;Car3.setOpacity(car3_opacity);&amp;#10;Car4.setOpacity(car4_opacity);&amp;#10;Ped1.setOpacity(ped1_opacity);&amp;#10;Ped2.setOpacity(ped2_opacity);&amp;#10;Ped3.setOpacity(ped3_opacity);&amp;#10;Ped4.setOpacity(ped4_opacity);&amp;#10;Ped5.setOpacity(ped5_opacity);&amp;#10;Ped6.setOpacity(ped6_opacity);&amp;#10;if ((group === &quot;friend&quot;)) {&amp;#10;    group_label = &quot;Crossing with: your close friends&quot;;&amp;#10;} else {&amp;#10;    group_label = &quot;Crossing with: strangers&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="env_clean = str(env).lower().strip()&amp;#10;distance_clean = str(distance).lower().strip()&amp;#10;&amp;#10;if env_clean == &quot;city&quot;:&amp;#10;    env_label = &quot;CITY CENTRE&quot;&amp;#10;    bg_color = &quot;#5f6672&quot;&amp;#10;    pave_color = &quot;#9aa0a8&quot;&amp;#10;    road_color = &quot;#55555c&quot;&amp;#10;    number_of_cars = 4&amp;#10;elif env_clean == &quot;suburb&quot;:&amp;#10;    env_label = &quot;QUIET SUBURB&quot;&amp;#10;    bg_color = &quot;#a9d68f&quot;&amp;#10;    pave_color = &quot;#cfe8b8&quot;&amp;#10;    road_color = &quot;#6a6a6a&quot;&amp;#10;    number_of_cars = 1&amp;#10;else:&amp;#10;    raise ValueError(&quot;Invalid environment: &quot; + str(env))&amp;#10;&amp;#10;# Cars&amp;#10;car1_opacity = 1&amp;#10;car2_opacity = 1 if number_of_cars &gt;= 2 else 0&amp;#10;car3_opacity = 1 if number_of_cars &gt;= 3 else 0&amp;#10;car4_opacity = 1 if number_of_cars &gt;= 4 else 0&amp;#10;&amp;#10;# Pedestrians&amp;#10;if distance_clean == &quot;far&quot;:&amp;#10;    xs = [0.50, 0.58, 0.66]&amp;#10;else:&amp;#10;    xs = [0.15, 0.30, 0.45]&amp;#10;&amp;#10;positions = []&amp;#10;for x in xs:&amp;#10;    positions.append((-x, -0.08))&amp;#10;    positions.append((x, -0.08))&amp;#10;&amp;#10;ped1_pos, ped2_pos, ped3_pos, ped4_pos, ped5_pos, ped6_pos = positions&amp;#10;&amp;#10;n = int(n_others)&amp;#10;ped1_opacity = 1 if n &gt;= 1 else 0&amp;#10;ped2_opacity = 1 if n &gt;= 2 else 0&amp;#10;ped3_opacity = 1 if n &gt;= 3 else 0&amp;#10;ped4_opacity = 1 if n &gt;= 4 else 0&amp;#10;ped5_opacity = 1 if n &gt;= 5 else 0&amp;#10;ped6_opacity = 1 if n &gt;= 6 else 0&amp;#10;&amp;#10;Background.setFillColor(bg_color)&amp;#10;Background.setLineColor(bg_color)&amp;#10;Farpavement.setFillColor(pave_color)&amp;#10;Farpavement.setLineColor(pave_color)&amp;#10;Road.setFillColor(road_color)&amp;#10;Road.setLineColor(road_color)&amp;#10;Nearpavement.setFillColor(pave_color)&amp;#10;Nearpavement.setLineColor(pave_color)&amp;#10;&am