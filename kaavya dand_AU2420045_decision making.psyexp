      <CodeComponent name="code_2" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="try:&amp;#10;    participant_number = int(expInfo['participant'])&amp;#10;except ValueError:&amp;#10;    logging.warning(&quot;Non-numeric participant ID; defaulting to 'stranger'&quot;)&amp;#10;    participant_number = 1   # also happens in pilot mode ('pilot')&amp;#10;&amp;#10;if participant_number % 2 == 1:&amp;#10;    group = &quot;stranger&quot;&amp;#10;    group_message = &quot;The other pedestrians are strangers to you.&quot;&amp;#10;else:&amp;#10;    group = &quot;friend&quot;&amp;#10;    group_message = &quot;The other pedestrians are close friends of yours.&quot;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="try {&amp;#10;    participant_number = Number.parseInt(expInfo[&quot;participant&quot;]);&amp;#10;} catch(e) {&amp;#10;    if ((e instanceof ValueError)) {&amp;#10;        logging.warning(&quot;Non-numeric participant ID; defaulting to 'stranger'&quot;);&amp;#10;        participant_number = 1;&amp;#10;    } else {&amp;#10;        throw e;&amp;#10;    }&amp;#10;}&amp;#10;if (((participant_number % 2) === 1)) {&amp;#10;    group = &quot;stranger&quot;;&amp;#10;    group_message = &quot;The other pedestrians are strangers to you.&quot;;&amp;#10;} else {&amp;#10;    group = &quot;friend&quot;;&amp;#10;    group_message = &quot;The other pedestrians are close friends of yours.&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
